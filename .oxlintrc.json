{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true,
		"typeCheck": false,
		"maxWarnings": 5000
	},
	"categories": {
		"correctness": "warn",
		"perf": "warn",
		"pedantic": "off",
		"nursery": "off",
		"restriction": "off"
	},
	"plugins": ["typescript", "oxc", "import", "unicorn", "promise", "jsdoc"],
	"ignorePatterns": [
		"packages/editor/node_modules/**",
		"packages/editor/dist/**",
		"packages/editor/dist-electron/**",
		"packages/editor/build/**",
		"packages/editor/main/**",
		"packages/editor/Unused/**",
		"packages/editor/jsons/**",
		"packages/editor/Project/Templates/**",
		"packages/editor/index.html",
		"packages/editor/Project/index.css",
		"packages/editor/Project/Apk/**",
		"packages/editor/Project/Fonts/**",
		"packages/editor/Project/Images/**",
		"packages/editor/Project/Locales/**"
	],
	"rules": {
		"eslint/no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_",
				"fix": {
					"imports": "safe-fix"
				}
			}
		],
		"typescript/no-explicit-any": "off",
		"typescript/no-namespace": "off",
		"typescript/no-non-null-assertion": "off",
		"eslint/no-console": "off",
		"eslint/no-empty": ["warn", { "allowEmptyCatch": true }]
	},
	"overrides": [
		{
			"files": ["packages/editor/src/**/*.vue", "packages/ui-kit/src/**/*.vue"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["electron"],
								"message": "Vue 组件禁止直接 import electron（vite electron-renderer-resolve 插件不覆盖 .vue），请经 legacy 模块（File/Log 等）中转"
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/editor/scripts/**/*.js", "packages/editor/*.config.js"],
			"env": {
				"node": true,
				"commonjs": true
			},
			"rules": {
				"eslint/no-undef": "off"
			}
		}
	]
}
