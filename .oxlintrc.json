{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true,
		"typeCheck": true,
		"maxWarnings": 0
	},
	"categories": {
		"correctness": "warn",
		"perf": "warn",
		"pedantic": "off",
		"nursery": "off",
		"restriction": "off"
	},
	"plugins": ["typescript", "oxc", "import", "unicorn", "promise", "jsdoc"],
	"ignorePatterns": [
		"packages/editor/node_modules/**",
		"packages/editor/dist/**",
		"packages/editor/dist-electron/**",
		"packages/editor/build/**",
		"packages/editor/jsons/**",
		"packages/editor/Project/Templates/**",
		"packages/editor/index.html",
		"packages/editor/Project/index.css",
		"packages/editor/Project/Apk/**",
		"packages/editor/Project/Fonts/**",
		"packages/editor/Project/Images/**",
		"packages/editor/Project/Locales/**",
		"packages/export-electron/node_modules/**",
		"packages/export-electron/out/**",
		"packages/export-electron/dist/**",
		"packages/template-arpg/runtime/**",
		"packages/template-arpg/languages/**",
		"packages/template-arpg/out/**",
		"packages/template-arpg/build/**",
		"packages/script/template/**",
		"build/**"
	],
	"rules": {		"eslint/no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_",
				"fix": {
					"imports": "safe-fix"
				}
			}
		],
		"typescript/no-namespace": "off",
		"typescript/no-non-null-assertion": "off",
		"eslint/no-console": ["warn", { "allow": ["error", "warn"] }],
		"eslint/no-empty": ["warn", { "allowEmptyCatch": true }],
		"eslint/no-unused-expressions": "warn",
		"eslint/no-await-in-loop": "warn",
		"eslint/no-constant-condition": "warn",
		"eslint/no-unsafe-optional-chaining": "warn",
		"typescript/no-explicit-any": "warn",
		"typescript/no-useless-default-assignment": "warn",
		"typescript/no-base-to-string": "warn",
		"typescript/unbound-method": "warn",
		"typescript/restrict-template-expressions": "warn",
		"typescript/no-this-alias": "warn",
		"typescript/no-redundant-type-constituents": "warn",
		"typescript/no-implied-eval": "warn",
		"unicorn/no-new-array": "warn",
		"oxc/no-map-spread": "warn"
	},
	"overrides": [
		{
			"files": ["packages/editor/src/**/*.vue", "packages/ui-kit/src/**/*.vue"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["electron"],
								"message": "Vue 组件禁止直接 import electron（vite electron-renderer-resolve 插件不覆盖 .vue），请经 legacy 模块（File/Log 等）中转"
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/editor/scripts/**/*.js", "packages/editor/*.config.js"],
			"env": {
				"node": true,
				"commonjs": true
			},
			"rules": {
				"eslint/no-undef": "off"
			}
		},
		{
			"files": ["scripts/**/*.js"],
			"env": {
				"node": true,
				"commonjs": true
			},
			"rules": {
				"eslint/no-undef": "off",
				"eslint/no-console": "off"
			}
		},
		{
			"files": ["packages/export-electron/scripts/**/*.js"],
			"env": {
				"node": true,
				"commonjs": true
			},
			"rules": {
				"eslint/no-undef": "off",
				"eslint/no-console": "off"
			}
		},
		{
			"files": [
				"packages/script/scripts/**/*.js",
				"packages/template-arpg/scripts/**/*.js",
				"packages/template-arpg/vite.config.ts"
			],
			"env": {
				"node": true,
				"commonjs": true
			},
			"rules": {
				"eslint/no-undef": "off",
				"eslint/no-console": "off"
			}
		},
		{
			"files": ["packages/editor/main/**/*.ts", "packages/editor/scripts/**/*.js"],
			"rules": {
				"eslint/no-console": "off"
			}
		},
		{
			"files": ["**/*.d.ts", "**/global.d.ts"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": ["**/*.spec.ts", "**/__tests__/**/*.ts"],
			"rules": {
				"typescript/unbound-method": "off",
				"typescript/no-explicit-any": "off"
			}
		}
	]
}
