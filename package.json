{
	"name": "yami-rpg-editor",
	"version": "1.0.0",
	"private": true,
	"description": "2D Game Editor (pnpm workspace root)",
	"author": "Yami",
	"repository": {
		"type": "git",
		"url": "https://github.com/yami-pro/yami-rpg-editor.git"
	},
	"scripts": {
		"prepare": "husky",
		"commitlint": "commitlint --config commitlint.config.js --edit ",
		"dev": "pnpm -F @yami/editor dev",
		"dev:ui": "pnpm -F @yami/ui-kit dev",
		"build:vite": "pnpm -F @yami/editor build:vite",
		"build:all": "pnpm -F @yami/editor build:all",
		"build:win": "pnpm -F @yami/editor build:win",
		"build:winexe": "pnpm -F @yami/editor build:winexe",
		"build:linux": "pnpm -F @yami/editor build:linux",
		"build:linuxexe": "pnpm -F @yami/editor build:linuxexe",
		"build:mac": "pnpm -F @yami/editor build:mac",
		"build:macexe": "pnpm -F @yami/editor build:macexe",
		"build:macArm": "pnpm -F @yami/editor build:macArm",
		"build:macArmexe": "pnpm -F @yami/editor build:macArmexe",
		"build:universal": "pnpm -F @yami/editor build:universal",
		"build:universalexe": "pnpm -F @yami/editor build:universalexe",
		"start:prod": "pnpm -F @yami/editor start:prod",
		"pack:resources": "node scripts/pack-resources.js",
		"release:verify": "node scripts/release-verify-tag.mjs",
		"release:notes": "node scripts/release-notes.mjs",
		"release:checksums": "node scripts/release-checksums.mjs",
		"debug:template": "node scripts/debug-template.js",
		"debug:template:watch": "node scripts/debug-template.js --watch",
		"typecheck": "pnpm -F @yami/editor typecheck",
		"lint": "oxlint -c ./.oxlintrc.json packages/editor packages/ui-kit scripts",
		"lint:fix": "oxlint -c ./.oxlintrc.json --fix packages/editor packages/ui-kit scripts",
		"dom:guard:tracker": "node scripts/dom-guard.mjs tracker",
		"dom:guard:fix": "node scripts/dom-guard.mjs fix",
		"migration:ledger": "node scripts/migration-ledger.mjs",
		"migration:check": "node scripts/migration-ledger.mjs --check",
		"migration:baseline": "node scripts/migration-ledger.mjs --update-baseline",
		"migration:selftest": "node scripts/lib/self-test.mjs",
		"migration:null-dead-stores": "node scripts/null-cast-dead-store-audit.mjs",
		"migration:cast-shapes": "node scripts/null-cast-shapes.mjs",
		"migration:lazy-slots": "node scripts/lazy-slot-codemod.mjs",
		"migration:lazy-slots-untyped": "node scripts/lazy-slot-untyped-codemod.mjs",
		"migration:lazy-slots-assign": "node scripts/lazy-slot-assign-codemod.mjs",
		"a11y:aria-labels": "node scripts/aria-label-codemod.mjs",
		"docs:check": "node scripts/docs-check.mjs",
		"stale-exemptions": "node scripts/stale-exemptions.mjs",
		"text:check": "node scripts/check-text-integrity.mjs",
		"text:rules": "node scripts/check-text-integrity.mjs --rules",
		"events:surface": "node scripts/event-surface.mjs",
		"style:scope": "node scripts/component-style-scope.mjs",
		"style:scope:selftest": "node scripts/component-style-scope.mjs --selftest",
		"format": "oxfmt -c ./.oxfmtrc.json --write packages/editor packages/ui-kit",
		"format:check": "oxfmt -c ./.oxfmtrc.json --check packages/editor packages/ui-kit"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"archiver": "^7.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005"
	},
	"packageManager": "pnpm@12.9.1",
	"dependencies": {
		"cross-env": "^10.1.0"
	}
}
