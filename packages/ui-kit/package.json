{
	"name": "@yami/ui-kit",
	"version": "0.1.0",
	"description": "Yami RPG Editor 通用组件库（纯 Vue 契约，CSS Module + design tokens）",
	"type": "module",
	"main": "./dist/ui-kit.js",
	"module": "./dist/ui-kit.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/ui-kit.js"
		},
		"./style.css": "./dist/ui-kit.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --config playground/vite.config.ts",
		"build": "vite build",
		"build:types": "vue-tsc --emitDeclarationOnly -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"create": "node scripts/create-component.js"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"jsdom": "^30.0.1",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vue": "^3.6.0-rc.3",
		"vue-tsc": "^3.3.9"
	}
}
