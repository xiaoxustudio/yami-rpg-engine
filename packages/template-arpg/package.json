{
  "name": "@yami/template-arpg",
  "version": "1.0.23",
  "description": "ARPG TS 游戏项目模板（多语言）",
  "private": true,
  "yami": {
    "minEditorVersion": "1.0.18",
    "projectVersion": "1.0.147"
  },
  "scripts": {
    "build": "vite build --mode zh-CN",
    "build:zh-cn": "vite build --mode zh-CN",
    "build:en-us": "vite build --mode en-US",
    "build:all": "vite build --mode zh-CN && vite build --mode en-US",
    "dev:assemble:zh-cn": "node scripts/dev-assemble.js --lang=zh-CN",
    "dev:assemble:en-us": "node scripts/dev-assemble.js --lang=en-US",
    "dev:assemble:watch:zh-cn": "node scripts/dev-assemble.js --lang=zh-CN --watch --compile",
    "dev:assemble:watch:en-us": "node scripts/dev-assemble.js --lang=en-US --watch --compile"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "22.20.1",
    "archiver": "^7.0.1",
    "vite": "^8.1.5"
  }
}
