{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"strictNullChecks": true,
		"noImplicitAny": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"@app/*": ["./src/*"],
			"@ui-kit": ["../ui-kit/src/index.ts"],
			"@ui-kit/*": ["../ui-kit/src/*"],
			"monaco-editor/esm/vs/editor/editor.api": ["./node_modules/monaco-editor/esm/vs/editor/editor.api"],
			"monaco-editor/esm/vs/editor/editor.all": ["./node_modules/monaco-editor/esm/vs/editor/editor.all"],
			"monaco-editor/esm/vs/language/typescript/monaco.contribution": ["./node_modules/monaco-editor/esm/vs/language/typescript/monaco.contribution"],
			"monaco-editor/esm/vs/language/json/monaco.contribution": ["./node_modules/monaco-editor/esm/vs/language/json/monaco.contribution"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "main/**/*.ts", "Project/global.d.ts"],
	"exclude": [
		"Project/Templates/**",
		"node_modules/**",
		"dist/**",
		"dist-electron/**",
		"build/**",
		"jsons/**"
	]
}








