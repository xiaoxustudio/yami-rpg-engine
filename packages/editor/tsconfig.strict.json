{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"strictNullChecks": true,
		"noImplicitAny": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"paths": {
			"@app/*": ["./src/*"],
			"@ui-kit": ["../ui-kit/src/index.ts"],
			"@ui-kit/*": ["../ui-kit/src/*"],
			"@/audio/*": ["./src/legacy/audio/*"],
			"@/printer/*": ["./src/legacy/printer/*"],
			"@/log/*": ["./src/legacy/log/*"],
			"@/plugin/*": ["./src/legacy/plugin/*"],
			"@/util/*": ["./src/legacy/util/*"],
			"@/types/*": ["./src/legacy/types/*"],
			"@/tools/*": ["./src/legacy/tools/*"],
			"@/data/*": ["./src/legacy/data/*"],
			"@/file/*": ["./src/legacy/file/*"],
			"@/inspector/*": ["./src/legacy/inspector/*"],
			"@/components/*": ["./src/legacy/components/*"],
			"@/command/*": ["./src/legacy/command/*"],
			"@/module/*": ["./src/legacy/module/*"],
			"@/scene/*": ["./src/legacy/scene/*"],
			"@/title/*": ["./src/legacy/title/*"],
			"@/ui/*": ["./src/legacy/ui/*"],
			"@/main/*": ["./src/legacy/main/*"],
			"@/tools/*": ["./src/legacy/tools/*"],
			"@/particle/*": ["./src/legacy/particle/*"],
			"@/palette/*": ["./src/legacy/palette/*"],
			"@/attribute/*": ["./src/legacy/attribute/*"],
			"@/enum/*": ["./src/legacy/enum/*"],
			"@/update/*": ["./src/legacy/update/*"],
			"@/version/*": ["./src/legacy/version/*"],
			"@/browser/*": ["./src/legacy/browser/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "main/**/*.ts", "Project/global.d.ts"],
	"exclude": [
		                "src/legacy/version/**",
		"Project/Templates/**",
		"node_modules/**",
		"dist/**",
		"dist-electron/**",
		"build/**",
		"Unused/**",
		"jsons/**"
	]
}








