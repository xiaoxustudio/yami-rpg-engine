{
	"compilerOptions": {
	  "paths": {
	   "@app/*": ["./src/*"],
	   "@ui-kit": ["../ui-kit/src/index.ts"],
	   "@ui-kit/*": ["../ui-kit/src/*"],
	   "monaco-editor/esm/vs/editor/editor.api": ["./node_modules/monaco-editor/esm/vs/editor/editor.api"],
	   "monaco-editor/esm/vs/editor/editor.all": ["./node_modules/monaco-editor/esm/vs/editor/editor.all"],
	   "monaco-editor/esm/vs/language/typescript/monaco.contribution": ["./node_modules/monaco-editor/esm/vs/language/typescript/monaco.contribution"],
	   "monaco-editor/esm/vs/language/json/monaco.contribution": ["./node_modules/monaco-editor/esm/vs/language/json/monaco.contribution"]
	  },
	 "target": "es2022",
	 "module": "esnext",
	 "moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable", "webworker"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"allowJs": false,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "main/**/*.ts", "Project/global.d.ts", "vitest.config.ts", "vitest.setup.ts"],
	"exclude": [
		"Project/Templates/**",
		"node_modules/**",
		"dist/**",
		"dist-electron/**",
		"build/**",
		"jsons/**"
	]
}
